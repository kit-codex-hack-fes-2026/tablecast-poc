{
  "name": "@tablecast/livekit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "uv run tablecast-voice dev",
    "start": "uv run tablecast-voice start",
    "download-files": "uv run tablecast-voice download-files",
    "lint": "uv run ruff check .",
    "format": "uv run ruff format .",

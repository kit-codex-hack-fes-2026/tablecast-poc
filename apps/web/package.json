{
  "name": "@tablecast/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.local/.env exec 'cf dev'",
    "build": "vite build --mode ${TABLECAST_MODE:-development} && node ../../scripts/tablecast-clean-build.ts",
    "preview": "bun --env-file=../../.local/.env exec 'vite preview'",
    "typecheck": "node ../../node_modules/@tablecast/typescript-native/bin/tsc --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "lint": "oxlint . --type-aware --deny-warnings",
    "format": "oxfmt --write .",
    "test": "vitest run --config vitest.config.ts --project unit",
    "test:browser": "bun run i18n:compile --output-structure locale-modules && vitest run --config vitest.config.ts --project storybook --project browser",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --no-open --port 6006",
    "build:storybook": "bun run i18n:compile --output-structure message-modules && storybook build",
    "format:check": "oxfmt --check .",
    "dev:container": "bun --env-file=../../.local/.env exec 'cf dev'",
    "build:local": "umask 077 && TABLECAST_LOCAL_BUILD=1 bun --env-file=../../.local/.env run ../../scripts/tablecast-build.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/infra": "0.4.20",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@better-auth/stripe": "1.7.10",
    "@inference-net/otel-cf-workers": "2.6.1",
    "@opentelemetry/api": "1.9.1",
    "@paper-design/shaders-react": "0.0.81",
    "@tablecast/api": "workspace:*",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-hotkeys": "0.15.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.3",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@unpic/react": "1.0.2",
    "better-auth": "1.7.10",
    "eventsource-parser": "4.1.2",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "qr-scanner": "1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.5",
    "shadcn": "4.22.0",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@cloudflare/workers-types": "5.20261016.1",
    "@inlang/paraglide-js": "2.29.0",
    "@playwright/test": "1.64.1",
    "@serwist/vite": "9.5.13",
    "@serwist/window": "9.5.13",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/tanstack-react": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-storybook": "10.6.2",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tailwindcss": "1.16.0",
    "serwist": "9.5.13",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "wrangler": "4.151.1"
  }
}

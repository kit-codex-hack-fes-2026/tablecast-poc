    "zbsearch": "4.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.6",
    "@cloudflare/workers-types": "5.20261127.1",
    "@inlang/paraglide-js": "2.29.3",
    "@playwright/test": "1.65.1",
    "@serwist/vite": "9.6.0",
    "@serwist/window": "9.6.0",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-mcp": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/tanstack-react": "10.6.9",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.108.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/mdx": "2.0.14",
    "@types/node": "^24.19.2",

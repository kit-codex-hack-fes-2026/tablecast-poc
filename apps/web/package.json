{
  "name": "@tablecast/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.local/.env exec 'cf dev'",
    "build": "vite build --mode ${TABLECAST_MODE:-development} && node ../../scripts/tablecast-clean-build.ts",
    "preview": "bun --env-file=../../.local/.env exec 'vite preview'",
    "typecheck": "node ../../node_modules/@tablecast/typescript-native/bin/tsc --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang",
    "lint": "oxlint . --type-aware --deny-warnings",
    "format": "oxfmt --write .",
    "test": "vitest run --config vitest.config.ts --project unit",
    "test:browser": "bun run i18n:compile --output-structure locale-modules && vitest run --config vitest.config.ts --project storybook --project browser --project browser-performance",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --no-open --port 6006",
    "build:storybook": "bun run i18n:compile --output-structure message-modules && storybook build",
    "format:check": "oxfmt --check .",
    "dev:container": "bun --env-file=../../.local/.env exec 'cf dev'",
    "build:local": "umask 077 && TABLECAST_LOCAL_BUILD=1 bun --env-file=../../.local/.env run ../../scripts/tablecast-build.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/infra": "0.4.31",
    "@better-auth/oauth-provider": "1.7.28",
    "@better-auth/passkey": "1.7.28",
    "@better-auth/stripe": "1.7.28",
    "@inference-net/otel-cf-workers": "2.6.1",
    "@opentelemetry/api": "1.10.0",
    "@paper-design/shaders-react": "0.0.82",
    "@radix-ui/colors": "3.0.0",
    "@tablecast/api": "workspace:*",
    "@tanstack/charts": "1.5.0",
    "@tanstack/react-form": "1.33.6",
    "@tanstack/react-hotkeys": "0.27.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.7",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/core": "3.35.1",
    "@tiptap/extension-image": "3.35.1",
    "@tiptap/extension-table": "3.35.1",
    "@tiptap/extension-task-item": "3.35.1",
    "@tiptap/extension-task-list": "3.35.1",
    "@tiptap/markdown": "3.35.1",
    "@tiptap/pm": "3.35.1",
    "@tiptap/react": "3.35.1",
    "@tiptap/starter-kit": "3.35.1",
    "@unpic/placeholder": "0.1.2",
    "@unpic/react": "1.0.2",
    "@zbsearch/tokenizers": "4.0.4",
    "better-auth": "1.7.28",
    "flag-icons": "7.6.0",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "fumadocs-ui": "16.19.7",
    "lucide-react": "1.82.0",
    "motion": "14.14.0",
    "qr-scanner": "1.4.2",
    "qrcode.react": "^4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.25.1",
    "shadcn": "4.23.1",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.5",

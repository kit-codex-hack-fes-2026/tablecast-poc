{
  "name": "@tablecast/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "bun run i18n:compile && tsc --noEmit",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "lint": "oxlint src e2e .storybook vite.config.ts vitest.config.ts playwright.config.ts --deny-warnings",
    "format": "oxfmt --write .",
    "test": "vitest run --config vitest.config.ts --project unit",
    "test:browser": "vitest run --config vitest.config.ts --project storybook",
    "test:e2e": "playwright test",
    "storybook": "storybook dev --no-open --port 6006",
    "build:storybook": "storybook build",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@paper-design/shaders-react": "0.0.80",
    "@tablecast/api": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "livekit-client": "2.22.2",
    "lucide-react": "0.577.0",
    "motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "streamdown": "^2.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260903.1",
    "@inlang/paraglide-js": "2.25.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}

assets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
assets/**/*.webm filter=lfs diff=lfs merge=lfs -text
assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
assets/**/*.openscreen -filter diff merge -text
assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
assets/**/*.png filter=lfs diff=lfs merge=lfs -text
# 収録証跡のハッシュを維持し、checkout時の改行変換をしない。
assets/openscreen/**/*.json -text -diff linguist-generated=true
assets/openscreen/**/tablecast-record.log -text -diff linguist-generated=true
# 原配布ライセンスとpatchの文脈行は空白を含めて保持する。
assets/audio/kenney-license.txt -whitespace
experiments/tablecast-mutation/application.patch whitespace=-blank-at-eol,-space-before-tab

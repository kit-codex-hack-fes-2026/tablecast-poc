{
  "name": "@tablecast/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./catalog-search": "./src/modules/catalog/search.ts",
    "./localization": "./src/modules/catalog/localization.ts",
    "./speech": "./src/modules/voice/prompt.ts",
    "./telemetry": "./src/platform/telemetry.ts",
    "./db": "./src/db/public.ts",
    "./bootstrap": "./src/bootstrap.ts",
    "./media-migration": "./src/modules/media/migration.ts",
    "./store-knowledge": "./src/modules/configuration/knowledge.ts"
  },
  "scripts": {
    "typecheck": "node ../../node_modules/@tablecast/typescript-native/bin/tsc --noEmit",
    "test": "vitest run",
    "cf:typegen": "cf workers types --mode development --include-runtime=false",
    "lint": "oxlint . --type-aware --deny-warnings",
    "build:email": "bun --no-env-file scripts/tablecast-email-preview.ts && email build --dir .local/tablecast-email && bun --no-env-file scripts/tablecast-email-cloudflare.ts && cd .react-email && opennextjs-cloudflare build --config ../.local/tablecast-email.wrangler.json --openNextConfigPath ../tablecast-email.open-next.config.ts",
    "preview:email": "cd .react-email && opennextjs-cloudflare preview --config ../.local/tablecast-email.wrangler.json",
    "cf:build": "cf build --mode ${TABLECAST_MODE:-development} && node ../../scripts/tablecast-clean-build.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.10",
    "@better-auth/infra": "0.4.20",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/passkey": "1.7.10",
    "@better-auth/stripe": "1.7.10",
    "@cloudflare/containers": "0.3.7",
    "@hono/mcp": "0.3.2",
    "@hono/zod-validator": "0.9.1",
    "@inference-net/otel-cf-workers": "2.6.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@unpic/pixels": "1.3.0",
    "better-auth": "1.7.10",
    "blurhash": "2.0.5",
    "css-tree": "^3.2.1",
    "drizzle-orm": "1.0.0-rc.5",
    "fuse.js": "7.5.0",
    "hono": "4.13.13",
    "openai": "7.36.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "22.6.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@react-email/ui": "6.11.3",
    "@types/css-tree": "^3.2.0",
    "@types/react": "19.3.0",
    "drizzle-kit": "1.0.0-rc.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-hono": "1.1.0",
    "react-email": "6.11.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

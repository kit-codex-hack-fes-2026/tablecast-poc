{
  "name": "@tablecast/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./speech": "./src/modules/voice/prompt.ts",
    "./telemetry": "./src/platform/telemetry.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.local/.env exec 'cf dev --mode development --port \"$TABLECAST_API_PORT\"'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:typegen": "cf workers types --mode development --include-runtime=false",
    "lint": "oxlint src test scripts oxlint.config.ts --type-aware --deny-warnings",
    "build:email": "bun --no-env-file scripts/tablecast-email-build.ts",
    "cf:build": "cf build --mode ${TABLECAST_MODE:-development} && node ../../scripts/tablecast-clean-build.ts",
    "preview": "bun --env-file=../../.local/.env run ../web/node_modules/.bin/vite preview --config ../web/tablecast-api-preview.config.ts --port 0"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/infra": "0.4.9",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/passkey": "1.7.2",
    "@cloudflare/containers": "0.3.7",
    "@hono/mcp": "0.3.2",
    "@hono/zod-validator": "0.9.1",
    "@inference-net/otel-cf-workers": "2.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "better-auth": "1.7.2",
    "css-tree": "^3.2.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "openai": "7.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20260903.1",
    "@types/css-tree": "^3.2.0",
    "@types/react": "19",
    "drizzle-kit": "0.31.10",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-hono": "1.0.6",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}

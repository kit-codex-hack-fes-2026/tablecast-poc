{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "node",
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "auth.config.ts",
    "oxlint.config.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts"
  ]
}

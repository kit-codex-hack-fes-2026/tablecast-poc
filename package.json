{
  "name": "tablecast-poc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "livekit"
  ],
  "type": "module",
  "scripts": {
    "deploy": "tsx scripts/tablecast-deploy.ts",
    "build:deploy": "bun --no-env-file scripts/tablecast-deploy.ts --build",
    "dev:prepare": "bun run dev:config && bun run db:migrate && bun run db:seed",
    "dev": "turbo run dev --filter=@tablecast/web",
    "dev:parity": "turbo run preview --filter=@tablecast/web",
    "db:seed": "bun --no-env-file scripts/tablecast-seed.ts",
    "demo:reset": "bun --no-env-file scripts/tablecast-seed.ts --reset",
    "demo:play": "bun --no-env-file scripts/tablecast-demo.ts",
    "storybook": "bun run --cwd apps/web storybook",
    "build": "turbo run build",
    "typecheck": "bun run codegen && tsc --noEmit && turbo run typecheck",
    "lint": "bun run codegen && oxlint --type-aware --deny-warnings && turbo run lint",
    "format": "oxfmt --write . && turbo run format",
    "format:check": "oxfmt --check . && turbo run format:check",
    "test": "vitest run --config vitest.config.ts && turbo run test",
    "test:browser": "turbo run test:browser",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "hooks:install": "lefthook install",
    "db:bootstrap": "bun --no-env-file scripts/tablecast-bootstrap.ts",
    "codegen": "turbo run i18n:compile",
    "prepare": "bun run hooks:install",
    "setup": "bun --no-env-file install --frozen-lockfile && uv sync --project livekit --locked && bun run codegen",
    "dev:config": "NODE_ENV=development bun scripts/tablecast-runtime.ts",
    "db:migrate": "wrangler d1 migrations apply TABLECAST_DB --local --config .local/api.wrangler.json --persist-to .local/state",
    "dev:container": "turbo run dev:container --filter=@tablecast/web",
    "dev:proxy": "bun --env-file=.local/.env exec 'portless alias \"$TABLECAST_HOST\" \"$PORT\" && portless proxy start --foreground --no-tls --port \"$PORTLESS_PORT\"'",
    "dev:caddy": "caddy run --config .devcontainer/Caddyfile --adapter caddyfile",
    "dev:mailpit": "mailpit --listen 0.0.0.0:8025 --smtp 0.0.0.0:1025",
    "dev:livekit": "livekit-server --config .local/livekit.yaml",
    "services:up": "docker compose --env-file .local/.env -f infra/compose.yaml up --detach --wait",
    "services:down": "docker compose --env-file .local/.env -f infra/compose.yaml down --timeout 5",
    "services:status": "docker compose --env-file .local/.env -f infra/compose.yaml ps"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260903.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@faker-js/faker": "10.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.1",
    "@types/node": "24.13.3",
    "drizzle-orm": "0.45.2",
    "jsonc-parser": "3.3.1",
    "lefthook": "2.1.12",
    "livekit-server-sdk": "2.18.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.6",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.129.0",
    "zod": "4.5.4"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=24.7.0"
  },
  "packageManager": "bun@1.3.13",
  "patchedDependencies": {
    "miniflare@5.20260903.0-alpha": "patches/miniflare@5.20260903.0-alpha.patch"
  }
}

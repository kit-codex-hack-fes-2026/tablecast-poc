{
  "name": "tablecast-poc",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "deploy": "tsx scripts/tablecast-deploy.ts",
    "build:deploy": "bun --no-env-file scripts/tablecast-deploy.ts --build",
    "dev:prepare": "bun run dev:config && bun run db:migrate && bun run db:seed",
    "dev": "turbo run dev --filter=@tablecast/web",
    "dev:parity": "turbo run preview --filter=@tablecast/web",
    "db:seed": "bun scripts/tablecast-seed.ts",
    "demo:reset": "bun scripts/tablecast-seed.ts --reset",
    "demo:play": "bun scripts/tablecast-demo.ts",
    "demo:audio": "bun --no-env-file scripts/tablecast-demo-audio.ts",
    "storybook": "bun run --cwd apps/web storybook",
    "build": "bun --no-env-file scripts/tablecast-build.ts",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "lint": "oxlint --type-aware --deny-warnings && turbo run lint",
    "format": "oxfmt --write . && turbo run format",
    "format:check": "oxfmt --check . && turbo run format:check",
    "test": "vitest run --config vitest.config.ts && turbo run test",
    "test:browser": "turbo run test:browser",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "check": "bun run codegen && bun run format:check && bun run lint && bun run typecheck && bun run test",
    "hooks:install": "lefthook install",
    "db:bootstrap": "tsx scripts/tablecast-bootstrap.ts",
    "codegen": "turbo run i18n:compile",
    "prepare": "bun run hooks:install",
    "setup": "bun install --frozen-lockfile && bun run codegen",
    "dev:config": "NODE_ENV=development bun scripts/tablecast-runtime.ts",
    "db:migrate": "bun run cf:local d1 migrations apply 00000000-0000-4000-8000-000000000000 --dir apps/api/migrations --local --persist-to .local/state",
    "dev:container": "turbo run dev:container --filter=@tablecast/web",
    "dev:proxy": "bun --env-file=.local/.env exec 'portless alias \"$TABLECAST_HOST\" \"$PORT\" && portless proxy start --foreground --no-tls --port \"$PORTLESS_PORT\"'",
    "dev:caddy": "caddy run --config .devcontainer/Caddyfile --adapter caddyfile",
    "dev:mailpit": "mailpit --listen 0.0.0.0:8025 --smtp 0.0.0.0:1025",
    "services:up": "docker compose --env-file .local/.env up --detach --wait",
    "services:down": "docker compose --env-file .local/.env down --timeout 5",
    "services:status": "docker compose --env-file .local/.env ps",
    "build:email": "turbo run build:email",
    "deploy:catalog": "bun --no-env-file scripts/tablecast-catalog-deploy.ts",
    "infra:plan": "tsx scripts/tablecast-infra.ts",
    "infra:apply": "tsx scripts/tablecast-infra.ts --apply",
    "cf:local": "node scripts/tablecast-cf-local.ts"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.9.0",
    "@cloudflare/config": "0.24.1",
    "@cloudflare/workers-types": "5.20260903.1",
    "@cloudflare/workers-utils": "0.47.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.1",
    "@types/node": "24.13.3",
    "cf": "1.0.0-beta.14",
    "drizzle-orm": "0.45.2",
    "jsonc-parser": "3.3.1",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "portless": "0.15.6",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0",
    "zod": "4.5.4"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=24.7.0"
  },
  "packageManager": "bun@1.3.13"
}

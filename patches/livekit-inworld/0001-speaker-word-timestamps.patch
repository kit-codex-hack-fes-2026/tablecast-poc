+def transcription_to_speech_data(
+    transcription: dict,
+    *,
+    language: str,
+    request_id: str,
+    start_time_offset: float,
+    include_word_timestamps: bool,
+    enable_speaker_diarization: bool,
+    metadata: dict | None = None,
+) -> stt.SpeechData:
+    """単語を原文のまま保持し、欠損した話者や時刻を補完しない。"""
+    words: list[TimedString] = []
+    for word in transcription.get("wordTimestamps", []) if include_word_timestamps else []:
+        start, end = word.get("startTimeMs"), word.get("endTimeMs")
+        valid_time = (
+            isinstance(start, (int, float))
+            and not isinstance(start, bool)
+            and isinstance(end, (int, float))
+            and not isinstance(end, bool)
+            and math.isfinite(start)
+            and math.isfinite(end)
+            and 0 <= start <= end
+        )
+        speaker = word.get("speaker")
+        speaker_id = (
+            f"{request_id}:{speaker}"
+            if enable_speaker_diarization
+            and transcription.get("isFinal")
+            and isinstance(speaker, int)
+            and not isinstance(speaker, bool)
+            and speaker >= 0
+            else None
+        )
+        confidence = word.get("confidence")
+        words.append(
+            TimedString(
+                text=word.get("word", ""),
+                start_time=start / 1000 + start_time_offset if valid_time else NOT_GIVEN,
+                end_time=end / 1000 + start_time_offset if valid_time else NOT_GIVEN,
+                start_time_offset=start_time_offset if valid_time else NOT_GIVEN,
+                confidence=confidence
+                if isinstance(confidence, (int, float))
+                and not isinstance(confidence, bool)
+                and math.isfinite(confidence)
+                and 0 <= confidence <= 1
+                else NOT_GIVEN,
+                speaker_id=speaker_id,
+            )
+        )
+    # 複数話者や未帰属語が混ざった発話を一人に帰属させない。
+    speakers = {word.speaker_id for word in words}
+    speaker_id = next(iter(speakers)) if len(speakers) == 1 else None
+    start_times = [word.start_time for word in words if utils.is_given(word.start_time)]
+    end_times = [word.end_time for word in words if utils.is_given(word.end_time)]
+    return stt.SpeechData(
+        text=transcription.get("transcript", ""),
+        language=LanguageCode(language),
+        start_time=start_times[0] if start_times else 0.0,
+        end_time=end_times[-1] if end_times else 0.0,
+        speaker_id=speaker_id,
+        words=words or None,
+        metadata=metadata,
+    )
diff --git a/livekit-plugins/livekit-plugins-inworld/tests/test_diarization.py b/livekit-plugins/livekit-plugins-inworld/tests/test_diarization.py

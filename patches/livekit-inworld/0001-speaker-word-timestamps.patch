+++ b/livekit-plugins/livekit-plugins-inworld/tests/test_diarization.py
@@ -0,0 +1,122 @@
+"""実プロバイダーに接続せず、変換と既定互換性を検証する。"""
+
+import pytest
+
+from livekit.agents import stt
+from livekit.agents.types import NOT_GIVEN
+from livekit.plugins.inworld.stt import STT, transcription_to_speech_data
+
+
+def convert(words, *, final=True, request_id="stream-1", offset=0, enabled=True, text="はい二杯"):
+    return transcription_to_speech_data(
+        {"transcript": text, "isFinal": final, "wordTimestamps": words},
+        language="ja-JP",
+        request_id=request_id,
+        start_time_offset=offset,
+        include_word_timestamps=enabled,
+        enable_speaker_diarization=enabled,
+    )
+
+
+def test_話者ゼロと日本語単語とミリ秒を保持する():
+    value = convert(
+        [
+            {"word": "はい", "startTimeMs": 0, "endTimeMs": 100, "speaker": 0},
+            {"word": "二杯", "startTimeMs": 120, "endTimeMs": 250, "speaker": 0},
+        ],
+        offset=3,
+    )
+    assert value.text == "はい二杯"
+    assert value.speaker_id == "stream-1:0"
+    assert value.words[0] == "はい"
+    assert value.words[0].start_time == 3.0
+    assert value.words[1].end_time == 3.25
+    assert value.start_time == 3.0
+
+
+def test_複数話者と未帰属語を一人へまとめない():
+    value = convert([{"word": "はい", "speaker": 0}, {"word": "二", "speaker": 1}, {"word": "杯"}])
+    assert value.speaker_id is None
+    assert [word.speaker_id for word in value.words] == ["stream-1:0", "stream-1:1", None]
+
+
+@pytest.mark.parametrize(
+    "start,end",
+    [(None, 1), (-1, 1), (2, 1), (float("nan"), 2), (True, 2)],
+    ids=["欠損", "負値", "逆転", "非数", "真偽"],
+)
+def test_不正時刻をゼロ秒へ偽装しない(start, end):
+    value = convert([{"word": "はい", "startTimeMs": start, "endTimeMs": end}])
+    assert value.words[0].start_time is NOT_GIVEN
+    assert value.words[0].end_time is NOT_GIVEN
+
+
+def test_再接続すると同じ番号でも別の話者スコープになる():
+    word = [{"word": "はい", "speaker": 0}]
+    assert convert(word).speaker_id != convert(word, request_id="stream-2").speaker_id
+
+
+def test_暫定発話を確定した話者として扱わない():
+    value = convert([{"word": "はい", "speaker": 0}], final=False)
+    assert value.speaker_id is None
+    assert value.words[0].speaker_id is None
+
+
+def test_無効時は既定の単一候補と原文を保持する():
+    value = convert([{"word": "はい", "speaker": 0}], enabled=False)
+    assert value == stt.SpeechData(language="ja-JP", text="はい二杯")
+
+
+async def test_既定設定は話者を要求せず明示設定だけが両方要求する():
+    normal = STT(api_key="tablecast-test", enable_voice_profile=False)
+    enabled = STT(
+        api_key="tablecast-test", enable_voice_profile=False, enable_speaker_diarization=True
+    )
+    a, b = normal.stream(), enabled.stream()
+    try:
+        assert "enableSpeakerDiarization" not in a._build_transcribe_config()
+        assert "includeWordTimestamps" not in a._build_transcribe_config()
+        assert b._build_transcribe_config()["enableSpeakerDiarization"] is True
+        assert b._build_transcribe_config()["includeWordTimestamps"] is True
+        assert enabled.capabilities.diarization is True
+    finally:
+        await a.aclose()
+        await b.aclose()
+        await normal.aclose()
+        await enabled.aclose()
+
+
+async def test_暫定再送と空finalで発話境界を増やさない():
+    engine = STT(
+        api_key="tablecast-test", enable_voice_profile=False, enable_speaker_diarization=True
+    )
+    stream = engine.stream()
+    try:
+        stream._process_stream_event({"result": {"speechStarted": {}}})
+        stream._process_stream_event(
+            {"result": {"transcription": {"transcript": "はい", "isFinal": False}}}
+        )
+        stream._process_stream_event(
+            {"result": {"transcription": {"transcript": "はい", "isFinal": False}}}
+        )
+        stream._process_stream_event(
+            {"result": {"transcription": {"transcript": "", "isFinal": True}}}
+        )
+        events = [stream._event_ch.recv_nowait() for _ in range(4)]
+        assert [event.type for event in events] == [
+            stt.SpeechEventType.START_OF_SPEECH,
+            stt.SpeechEventType.INTERIM_TRANSCRIPT,
+            stt.SpeechEventType.INTERIM_TRANSCRIPT,
+            stt.SpeechEventType.END_OF_SPEECH,
+        ]
+    finally:
+        await stream.aclose()
+        await engine.aclose()
+
+
+def test_英語原文と単語の綴りを再構成せず保持する():
+    value = convert(
+        [{"word": "Two", "speaker": 0}, {"word": "teas.", "speaker": 0}], text="Two teas."
+    )
+    assert value.text == "Two teas."
+    assert [str(word) for word in value.words] == ["Two", "teas."]

{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommitTypeAll(build)",
  ],
  enabledManagers: ["bun", "bun-version", "mise", "github-actions", "dockerfile", "docker-compose"],
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    ".agents/skills/**",
  ],
  baseBranchPatterns: ["staging"],
  branchPrefix: "codex/renovate/",
  timezone: "Asia/Tokyo",
  schedule: ["* 6-11 * * 1"],
  draftPR: true,
  automerge: false,
  labels: ["build"],
  dependencyDashboard: true,
  dependencyDashboardTitle: "Dependency Dashboard",
  dependencyDashboardLabels: ["build"],
  dependencyDashboardAutoclose: false,
  dependencyDashboardHeader: "Renovateによる更新・検出済み依存・保留理由を管理する。通常更新は日本時間の月曜6〜12時に提案する。PRはstaging向けDraftで作成し、確認後に手動でマージする。",
  prConcurrentLimit: 3,
  prHourlyLimit: 2,
  semanticCommits: "enabled",
  semanticCommitType: "build",
  semanticCommitScope: null,
  commitMessageAction: "⬆️ update",
  commitBody: "Update the dependency declarations and generated lockfiles to the proposed versions.\n\nRefs #292",
  prTitle: "{{{depName}}}を{{{newValue}}}へ更新する",
  prBodyTemplate: "## 変更内容\n\n依存関係を更新し、宣言された版とlockfile・実行環境の指定を揃える。対象と更新前後の版は次の表に示す。\n\n{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}\n\n## 意思決定と最小実装\n\n標準Renovate managerと既存のpackage scripts・CIを使う。非major更新をまとめ、major更新は互換性が必要な単位で分ける。独自の更新runnerは追加しない。\n\n## テスト戦略と確認結果\n\n対象headのCIでformat・lint・型・変更範囲に応じた既存試験とbuildを確認する。結果は最新headのチェックを参照する。手動の動作確認とカタログの配備・確認は未実施。移行手順が必要な場合はレビューで追記する。\n\n## 関連Issue\n\nRefs #292\n\n更新・再実行・保留の管理は[Dependency Dashboard](https://github.com/kit-codex-hack-fes-2026/tablecast-poc/issues?q=is%3Aissue%20is%3Aopen%20%22Dependency%20Dashboard%22%20in%3Atitle)を使う。導入Issueは規約の根拠として参照し、自動更新PRで閉じない。\n\n{{{controls}}}{{{footer}}}",
  lockFileMaintenance: {
    enabled: true,
    schedule: ["* 6-11 * * 1"],
    commitMessageAction: "⬆️ refresh",
    commitMessageTopic: "dependency lockfile",
    prTitle: "依存関係のlockfileを更新する",
  },
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    groupName: null,
    prTitle: "{{{depName}}}のセキュリティ更新を適用する",
  },
  packageRules: [
    {
      matchDepTypes: ["engines"],
      rangeStrategy: "bump",
    },
    {
      matchUpdateTypes: ["minor", "patch", "pin", "digest", "pinDigest"],
      groupName: "non-major dependencies",
      groupSlug: "non-major-dependencies",
      prTitle: "非majorの依存関係をまとめて更新する",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["react", "react-dom", "@types/react", "@types/react-dom"],
      groupName: "react major dependencies",
      groupSlug: "react-major",
      prTitle: "React関連依存を次のmajorへ更新する",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["storybook", "@storybook/**", "eslint-plugin-storybook"],
      groupName: "storybook major dependencies",
      groupSlug: "storybook-major",
      prTitle: "Storybook関連依存を次のmajorへ更新する",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["vitest", "@vitest/**", "vitest-browser-react"],
      groupName: "vitest major dependencies",
      groupSlug: "vitest-major",
      prTitle: "Vitest関連依存を次のmajorへ更新する",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["better-auth", "@better-auth/**"],
      groupName: "better auth major dependencies",
      groupSlug: "better-auth-major",
      prTitle: "Better Auth関連依存を次のmajorへ更新する",
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: [
        "@tanstack/react-start",
        "@tanstack/react-router",
        "@tanstack/react-router-ssr-query",
      ],
      groupName: "tanstack start major dependencies",
      groupSlug: "tanstack-start-major",
      prTitle: "TanStack StartとRouterを次のmajorへ更新する",
    },
    {
      description: "既存ツール向けのJavaScript APIはTypeScript 6系を維持する。CLI aliasへ適用しない。",
      matchDepNames: ["typescript"],
      allowedVersions: ">=6.0.0 <7.0.0",
    },
    {
      description: "CLI aliasは安定したTypeScript 7系のみ追跡しnightlyを導入しない。",
      matchDepNames: ["@tablecast/typescript-native"],
      allowedVersions: ">=7.0.0 <8.0.0",
      ignoreUnstable: true,
    },
    {
      matchPackageNames: ["@types/node"],
      allowedVersions: ">=24.0.0 <25.0.0",
    },
    {
      matchDatasources: ["node-version"],
      allowedVersions: ">=24.0.0 <25.0.0",
      rangeStrategy: "bump",
    },
    {
      matchDatasources: ["docker"],
      matchPackageNames: ["node"],
      allowedVersions: "/^24\\./",
    },
    {
      description: "既採用のcf 1系列betaを追跡する。",
      matchDepNames: ["cf"],
      allowedVersions: "^1.0.0-0",
      ignoreUnstable: false,
    },
    {
      description: "Build Output対応のVite plugin v2 betaを追跡し、latestタグのv1へ戻さない。",
      matchDepNames: ["@cloudflare/vite-plugin"],
      followTag: "beta",
      allowedVersions: "^2.0.0-0",
      ignoreUnstable: false,
    },
  ],
}

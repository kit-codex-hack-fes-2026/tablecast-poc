{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json", "oxlint.config.ts", "oxfmt.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@tablecast/web#build": {
      "dependsOn": ["^cf:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/tablecast/.mcp.json",
        "$TURBO_ROOT$/plugins/tablecast/skills/*/SKILL.md",
        "$TURBO_ROOT$/apps/api/src/**",
        "$TURBO_ROOT$/apps/api/cloudflare.config.ts",
        "$TURBO_ROOT$/scripts/tablecast-clean-build.ts",
        "$TURBO_ROOT$/scripts/tablecast-deploy-config.ts"
      ],
      "outputs": [".cloudflare/output/**", ".cloudflare/types/**"],
      "env": [
        "TABLECAST_LOCAL_BUILD",
        "TABLECAST_STATE_PATH",
        "TABLECAST_INSPECTOR_PORT",
        "TABLECAST_PUBLIC_ORIGIN",
        "TABLECAST_VITE_CACHE_DIR",
        "TABLECAST_MODE",
        "TABLECAST_CONFIG"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "test": {
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "test:browser": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "@tablecast/web#build:storybook": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/**"],
      "outputs": ["storybook-static/**"]
    },
    "@tablecast/api#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    },
    "//#dev:prepare": {
      "cache": false,
      "passThroughEnv": ["TABLECAST_*", "PORTLESS_*"]
    },
    "//#services:up": {
      "dependsOn": ["//#dev:prepare"],
      "cache": false,
      "passThroughEnv": ["DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG", "PORTLESS_*"]
    },
    "//#dev:caddy": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "//#dev:mailpit": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "@tablecast/emulate#dev": {
      "passThroughEnv": ["PORTLESS_*"],
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "@tablecast/emulate#dev:container": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "@tablecast/web#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#services:up"],
      "with": ["@tablecast/emulate#dev", "@tablecast/api#dev"],
      "passThroughEnv": ["PORTLESS_*"]
    },
    "@tablecast/web#dev:container": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"],
      "with": [
        "@tablecast/emulate#dev:container",
        "//#dev:caddy",
        "//#dev:mailpit",
        "@tablecast/api#dev:container"
      ]
    },
    "@tablecast/web#build:local": {
      "dependsOn": ["//#services:up"],
      "passThroughEnv": ["PORTLESS_*"],
      "cache": false
    },
    "@tablecast/web#preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build:local", "//#services:up"],
      "with": ["@tablecast/emulate#dev"],
      "passThroughEnv": ["PORTLESS_*"]
    },
    "@tablecast/web#i18n:compile": {
      "inputs": ["project.inlang/**", "messages/**", "package.json"],
      "outputs": ["src/paraglide/**"]
    },
    "@tablecast/web#typecheck": {
      "dependsOn": ["^typecheck", "i18n:compile"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/plugins/tablecast/.mcp.json"]
    },
    "@tablecast/web#lint": {
      "dependsOn": ["i18n:compile"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/plugins/tablecast/.mcp.json"]
    },
    "@tablecast/api#build:email": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/tablecast-catalog-config.ts",
        "$TURBO_ROOT$/docs/design/logos/tablecast-logo.png"
      ],
      "outputs": ["email-static/**"],
      "env": ["TABLECAST_RELEASE_SHA", "TABLECAST_PR_NUMBER"]
    },
    "cf:build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/tablecast-clean-build.ts",
        "$TURBO_ROOT$/scripts/tablecast-deploy-config.ts"
      ],
      "outputs": [".cloudflare/output/**", ".cloudflare/types/**"],
      "env": ["TABLECAST_MODE", "TABLECAST_CONFIG"]
    },
    "@tablecast/api#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"],
      "passThroughEnv": ["PORTLESS_*"]
    },
    "@tablecast/api#dev:container": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    }
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.json", "oxlint.config.ts", "oxfmt.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "@tablecast/web#build": {
      "dependsOn": ["^cf:build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/tablecast/.mcp.json",
        "$TURBO_ROOT$/plugins/tablecast/skills/*/SKILL.md",
        "$TURBO_ROOT$/apps/api/src/**",
        "$TURBO_ROOT$/apps/api/cloudflare.config.ts",
        "$TURBO_ROOT$/scripts/tablecast-clean-build.ts",
        "$TURBO_ROOT$/scripts/tablecast-deploy-config.ts"
      ],
      "outputs": [".cloudflare/output/**", ".cloudflare/types/**"],
      "env": ["TABLECAST_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "format": {
      "cache": false
    },
    "format:check": {},
    "test": {
      "dependsOn": ["^typecheck"],
      "cache": false
    },
    "test:browser": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "@tablecast/web#build:storybook": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/**"],
      "outputs": ["storybook-static/**"]
    },
    "@tablecast/api#typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    },
    "//#dev:prepare": {
      "cache": false,
      "passThroughEnv": ["TABLECAST_*", "PORTLESS_*", "PORT"]
    },
    "//#seed:template": {
      "inputs": [
        "scripts/**",
        "apps/api/src/**",
        "apps/api/migrations/**",
        "apps/emulate/src/tablecast-demo-identities.ts",
        "assets/demo/**",
        "package.json",
        "bun.lock",
        "turbo.json"
      ],
      "outputs": [".local/tablecast-seed-template/seed.json"]
    },
    "//#services:up": {
      "dependsOn": ["//#dev:prepare"],
      "cache": false,
      "passThroughEnv": ["DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG", "PORTLESS_*"]
    },
    "//#dev:caddy": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "//#dev:mailpit": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "@tablecast/emulate#dev": {
      "passThroughEnv": ["PORTLESS_*"],
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "@tablecast/emulate#dev:container": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"]
    },
    "@tablecast/web#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#services:up"],
      "with": ["@tablecast/emulate#dev"],
      "passThroughEnv": ["PORTLESS_*", "PORT", "HOST"]
    },
    "@tablecast/web#dev:container": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["//#dev:prepare"],
      "with": ["@tablecast/emulate#dev:container", "//#dev:caddy", "//#dev:mailpit"]
    },
    "@tablecast/web#build:local": {
      "dependsOn": ["//#dev:prepare"],
      "passThroughEnv": ["PORTLESS_*"],
      "cache": false
    },
    "@tablecast/web#preview": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build:local", "//#services:up"],
      "with": ["@tablecast/emulate#dev"],
      "passThroughEnv": ["PORTLESS_*", "PORT", "HOST"]
    },
    "@tablecast/web#i18n:compile": {
      "inputs": ["project.inlang/**", "messages/**", "package.json"],
      "outputs": ["src/paraglide/**"]
    },
    "@tablecast/web#typecheck": {
      "dependsOn": ["^typecheck", "i18n:compile"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/tablecast/.mcp.json",
        "$TURBO_ROOT$/apps/emulate/src/**"
      ]
    },
    "@tablecast/web#lint": {
      "dependsOn": ["i18n:compile"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/plugins/tablecast/.mcp.json",
        "$TURBO_ROOT$/apps/api/src/**",
        "$TURBO_ROOT$/apps/api/cloudflare.config.ts",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/apps/emulate/src/**"
      ]
    },
    "@tablecast/api#build:email": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/tablecast-catalog-config.ts",
        "$TURBO_ROOT$/apps/web/public/brand/**",
        "$TURBO_ROOT$/assets/demo/identities/haruka-sato.webp",
        "$TURBO_ROOT$/docs/design/themes/gomen/logo.png"
      ],
      "outputs": ["email-static/**"],
      "env": ["TABLECAST_RELEASE_SHA", "TABLECAST_PR_NUMBER"]
    },
    "cf:build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/tablecast-clean-build.ts",
        "$TURBO_ROOT$/scripts/tablecast-deploy-config.ts"
      ],
      "outputs": [".cloudflare/output/**", ".cloudflare/types/**"],
      "env": ["TABLECAST_*"]
    },
    "@tablecast/api#lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    }
  }
}

      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {service_namespace=\"tablecast\",deployment_environment_name=\"$environment\",service_name=\"$service\"} | tablecast_pr_number=~\"$pr\" |= \"tablecast.request_completed\" | unwrap tablecast_duration_ms | __error__=\"\" [$__interval]) by (http_route)",
          "queryType": "range",
          "legendFormat": "{{http_route}}{{tablecast_operation}} {{tablecast_channel}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },

      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "業務操作数",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "$tablecast_loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tablecast_operation, tablecast_channel) (count_over_time({service_namespace=\"tablecast\",deployment_environment_name=\"$environment\",service_name=\"$service\"} | tablecast_pr_number=~\"$pr\" |= \"tablecast.operation_completed\" [$__interval]))",
          "queryType": "range",

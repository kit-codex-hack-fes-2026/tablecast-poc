# .env.local へコピーする。空のままでもGUIを開発できる。
# 名前・origin・実Webポートは.local/.env、認証secretは.local/.dev.varsへ生成する。
# ホスト名はbranch末尾から決め、portはPortless/Dockerが割り当てる。
# 外部キーはサーバーだけへ渡す。
# GPT-Live 1とResponses delegationの利用権限があるOpenAI projectを使う。
TABLECAST_MODEL_API_KEY=
# Responses delegationの業務モデル。音声モデルgpt-live-1とは独立する。
TABLECAST_MODEL=gpt-6.1-terra

# 共有ローカルGrafana/Langfuseへ会話本文を記録する場合だけtrueにする。
TABLECAST_OTEL_CAPTURE_CONTENT=false

# 共有観測基盤: 初回は bun run tablecast:observability:up を実行する。
# Langfuse資格はworktree外の共有設定からAPIへ渡す。Cloud設定はdocs/observability.mdを参照。

# 組織AIキーはAPI Worker内だけで利用する。専用の開発Projectで設定する。
# Projectを設定すると組織作成時とCronで発行し、切替フラグは既存組織の準備後に有効化する。
TABLECAST_OPENAI_PROJECT_ID=
TABLECAST_OPENAI_ADMIN_API_KEY=
TABLECAST_OPENAI_KEY_ENCRYPTION_SECRET=
TABLECAST_ORGANIZATION_AI_ENABLED=false

# Stripe Sandbox用。通常のGUI開発とCIでは無効のままでよい。
TABLECAST_BILLING_ENABLED=false
TABLECAST_STRIPE_SECRET_KEY=
TABLECAST_STRIPE_WEBHOOK_SECRET=
# JSON配列の先頭が新規契約用。契約が残る旧版も保持する。詳細はdocs/billing.md。
TABLECAST_BILLING_RATES=
# 運営向け収支APIを許可するユーザーID（カンマ区切り）。店舗roleとは独立する。
TABLECAST_BILLING_OPERATOR_USER_IDS=

# Square接続。未設定でも通常のGUI開発を継続できる。
# 接続環境は未指定時production。自動試験は明示sandboxを使う。
# 公開HTTPS originのcallbackとWebhookをSquare Developer Consoleへ登録する。
TABLECAST_SQUARE_APPLICATION_ID=
TABLECAST_SQUARE_ENVIRONMENT=production
TABLECAST_SQUARE_APPLICATION_SECRET=
TABLECAST_SQUARE_WEBHOOK_SIGNATURE_KEY=
# 32文字以上の独立した暗号化secret。保存済み接続がある間は維持する。
TABLECAST_POS_ENCRYPTION_SECRET=

# .env.local へコピーする。空のままでもGUIを開発できる。
# 開発専用の資格を使う。認証secret、LiveKit鍵、origin、portは自動生成する。
# 通常音声: OpenAI Realtime 2.1 + Inworld TTS。4項目を設定後、uvでAgentを別途起動する。
TABLECAST_MODEL_API_KEY=
# Python SDKの標準名。同じファイル内の参照をuvが展開する。
OPENAI_API_KEY=${TABLECAST_MODEL_API_KEY}
INWORLD_API_KEY=
TABLECAST_INWORLD_VOICE_JA=
TABLECAST_INWORLD_VOICE_EN=

# 標準音声の一覧・実在性確認だけに使うRead権限の別キー。
TABLECAST_INWORLD_VOICES_API_KEY=
# Mastraのテキスト応答・自発接客で使うモデル。通常音声モデルとは独立する。
TABLECAST_MODEL=

# ローカルGrafanaへ会話本文を記録する場合だけtrueにする。
TABLECAST_OTEL_CAPTURE_CONTENT=false
# Hosted Mastra Observabilityへの送信を試す場合だけ設定する。
TABLECAST_MASTRA_ACCESS_TOKEN=
TABLECAST_MASTRA_PROJECT_ID=
TABLECAST_MASTRA_ENDPOINT=https://observability.mastra.ai

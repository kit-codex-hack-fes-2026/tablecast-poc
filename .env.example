# .env.local へコピーする。空のままでもGUIを開発できる。
# 認証secret、origin、portは自動生成する。外部キーはサーバーだけへ渡す。
# GPT-Live 1とAgents APIの利用権限があるOpenAI projectを使う。
TABLECAST_MODEL_API_KEY=
# Hosted Agents APIの業務モデル。音声モデルgpt-live-1とは独立する。
TABLECAST_MODEL=gpt-6-astra

# ローカルGrafanaへ会話本文を記録する場合だけtrueにする。
TABLECAST_OTEL_CAPTURE_CONTENT=false
